# Wie lange geschlossene Events in data/events.json bleiben, bevor sie ins Archiv wandern
EVENT_ARCHIVE_DAYS=3

# Fuer code-recherche/websuche.js: Web-Nachschlagefaehigkeit fuer die
# Selbstverbesserung (siehe code-recherche/README.md). Kostenloser Tavily-
# Key ohne Kreditkarte, siehe tavily.com. Muss HIER (nicht nur in
# code-recherche/.env) stehen, damit ihn eine geklonte Selbstverbesserungs-
# Session mit ererbt - der Klon hat code-recherche/.env nicht (gitignored).
TAVILY_API_KEY=
