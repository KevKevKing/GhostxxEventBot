DISCORD_TOKEN=dein-echter-discord-bot-token-hier

# Optional, falls du die IDs spaeter aendern willst:
GUILD_ID=919258127042510889
EVENT_CHANNEL_ID=1503123644321366268
EVENT_ROLE_ID=1511343501709676746
FORTY_EVENT_ROLE_ID=1511358566248743042
STATE_CHANNEL_ID=1478179319980363847

# Log- und Rueckzugskanal fuer den Bot
LOG_CHANNEL_ID=1535269549417693214
