{
  "name": "ghostxx-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Eigenes Fenster fuer das Ghostxx-Dashboard - komplett getrennt vom Bot selbst.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jimp": "^1.6.1",
    "to-ico": "^1.1.5"
  },
  "build": {
    "appId": "de.unknown.ghostxx.desktop",
    "productName": "Ghostxx",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "assets/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "GhostXX.exe"
    }
  }
}
