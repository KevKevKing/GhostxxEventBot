# Aufwachwort-Erkennung ueber openWakeWord (komplett lokal, kein Konto/
# Zugriffsschluessel noetig - anders als urspruenglich mit Picovoice geplant,
# siehe README.md). Wort ist "Hey Jarvis" (eines der wenigen fertigen
# openWakeWord-Modelle, "Ghost" selbst zu trainieren waere ein eigenes,
# groesseres Vorhaben gewesen).
AUFWACHWORT_MODELL_PFAD=./werkzeuge/openwakeword/hey_jarvis.onnx
AUFWACHWORT_MELSPEKTROGRAMM_PFAD=./werkzeuge/openwakeword/melspectrogram.onnx
AUFWACHWORT_EMBEDDING_PFAD=./werkzeuge/openwakeword/embedding_model.onnx

# Wo whisper.cpp liegt (vorkompiliertes Programm, siehe README.md).
WHISPER_PROGRAMM_PFAD=./werkzeuge/whisper-cli.exe
WHISPER_MODELL_PFAD=./werkzeuge/ggml-base.bin

# Wo Piper liegt (vorkompiliertes Programm, siehe README.md).
PIPER_PROGRAMM_PFAD=./werkzeuge/piper.exe
PIPER_STIMME_PFAD=./werkzeuge/de_DE-karlsson-low.onnx

# Dasselbe lokale Ollama wie der Discord-Bot.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELL=qwen3.5:9b
OLLAMA_MODELL_KLEIN=qwen3.5:2b
