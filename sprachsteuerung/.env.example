# Aufwachwort-Erkennung ueber sherpa-onnx's Keyword-Spotting (komplett
# lokal, kein Konto/Zugriffsschluessel noetig - anders als urspruenglich mit
# Picovoice geplant, siehe README.md). "GHOST" selbst als Stichwort per
# text2token.py in Tokens umgewandelt, ganz ohne eigenes Training.
AUFWACHWORT_MODELL_ORDNER=./werkzeuge/sherpa-kws

# Wo whisper.cpp liegt (vorkompiliertes Programm, siehe README.md).
WHISPER_PROGRAMM_PFAD=./werkzeuge/whisper-cli.exe
WHISPER_MODELL_PFAD=./werkzeuge/ggml-base.bin

# Wo Piper liegt (vorkompiliertes Programm, siehe README.md).
PIPER_PROGRAMM_PFAD=./werkzeuge/piper.exe
PIPER_STIMME_PFAD=./werkzeuge/de_DE-karlsson-low.onnx

# Optional: welches Mikrofon genau (siehe node geraete-auflisten.js fuer die
# Liste bei dir). Leer lassen = Windows-Standardgeraet.
MIKROFON_GERAETE_INDEX=

# Dasselbe lokale Ollama wie der Discord-Bot.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELL=qwen3.5:9b
OLLAMA_MODELL_KLEIN=qwen3.5:2b
