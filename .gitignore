pruefstichprobe/*.jpg
pruefstichprobe/*.JPG
pruefstichprobe/*.jpeg
pruefstichprobe/*.url
pruefstichprobe/wahrheit.json

# Diese zwei Skripte haben echte Spielernamen als Kommentare bei den
